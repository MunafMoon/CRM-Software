{
  "name": "@crm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-prisma.mjs",
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/ensure-prisma.mjs",
    "build": "tsc",
    "prestart": "node scripts/ensure-prisma.mjs",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "predb:seed": "node scripts/ensure-prisma.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "pretest": "node scripts/ensure-prisma.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
