{
  "name": "agency-crm",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test": "npm run test -w apps/api",
    "test:browser": "playwright test",
    "db:backup": "node scripts/database-backup.mjs",
    "db:restore-check": "node scripts/database-restore-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "deepmerge-ts": "^8.0.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "qs": "^6.16.0",
    "typescript-eslint": "^8.26.0"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts",
    "qs": "$qs"
  }
}
